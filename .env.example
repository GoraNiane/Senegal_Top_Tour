# ==============================================================================
# SENEGAL TOP TOUR — Variables d'environnement pour Vercel & Production
# ==============================================================================

# Port d'écoute pour l'exécution locale (géré automatiquement par Vercel en prod)
PORT=5000
NODE_ENV=production

# URL de connexion à votre base de données Neon Cloud (PostgreSQL)
# Récupérée depuis votre Dashboard Neon (https://neon.tech)
DATABASE_URL="postgresql://neondb_owner:VOTRE_MOT_DE_PASSE@ep-cool-fog-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require"


# Clé secrète de signature des Tokens JWT (générez une chaîne longue et sécurisée)
JWT_SECRET="senegal_top_tour_super_secret_jwt_key_2026_luxury_production_token"

# Identifiants de l'administrateur par défaut initialisé au seed
ADMIN_DEFAULT_EMAIL="admin@senegaltoptour.com"
ADMIN_DEFAULT_PASSWORD="VotreMotDePasseAdminSecurise2026!"

# Numéro WhatsApp officiel pour les alertes et contact direct (+221...)
WHATSAPP_PHONE="+221778848029"

# Domaine autorisé pour CORS (ou * pour autoriser le domaine Vercel)
CORS_ORIGIN="*"

# ==============================================================================
# Configuration Cloudinary (Hébergement et Optimisation des Images & Médias)
# ==============================================================================
# Récupérez ces identifiants sur https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="votre_cloud_name"
CLOUDINARY_API_KEY="votre_api_key"
CLOUDINARY_API_SECRET="votre_api_secret"
CLOUDINARY_FOLDER="senegal_top_tour"
# Ou via la variable CLOUDINARY_URL unique :
# CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

