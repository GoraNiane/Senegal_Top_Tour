# ==============================================================================
# SENEGAL TOP TOUR — Variables d'environnement pour Vercel & Production
# ==============================================================================

# Port d'écoute pour l'exécution locale (géré automatiquement par Vercel en prod)
PORT=5000
NODE_ENV=production

# URL de connexion à votre base de données hébergée (Cloud DB)
# Exemples :
# Railway / PlanetScale / Aiven (MySQL / MariaDB) :
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?sslaccept=strict"
# Supabase / Neon / Render (PostgreSQL - si provider = "postgresql") :
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?sslmode=require"

# Clé secrète de signature des Tokens JWT (générez une chaîne longue et sécurisée)
JWT_SECRET="senegal_top_tour_super_secret_jwt_key_2026_luxury_production_token"

# Identifiants de l'administrateur par défaut initialisé au seed
ADMIN_DEFAULT_EMAIL="admin@senegaltoptour.com"
ADMIN_DEFAULT_PASSWORD="VotreMotDePasseAdminSecurise2026!"

# Numéro WhatsApp officiel pour les alertes et contact direct (+221...)
WHATSAPP_PHONE="+221778848029"

# Domaine autorisé pour CORS (ou * pour autoriser le domaine Vercel)
CORS_ORIGIN="*"
